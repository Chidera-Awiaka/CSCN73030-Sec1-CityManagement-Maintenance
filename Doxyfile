# ============================================================

# Maintenance Service - Sprint 2 Doxygen configuration

# Run from the repository root:

# doxygen Doxyfile

# ============================================================

# ------------------------------------------------------------

# Project information

# ------------------------------------------------------------

PROJECT_NAME = "Maintenance Service - Sprint 2"
PROJECT_BRIEF = "City Management - Maintenance Service Sprint 2 design documentation"

OUTPUT_DIRECTORY = docs/sprint2
OUTPUT_LANGUAGE = English
DOXYFILE_ENCODING = UTF-8

# ------------------------------------------------------------

# Input files

# ------------------------------------------------------------

# Main backend source code

# Tests

# Project documentation

# README used as main page

INPUT = README.md \
 backend/Maintenance.Api \
 tests \
 docs

INPUT_ENCODING = UTF-8

FILE_PATTERNS = _.cs \
 _.md \
 \*.dox

RECURSIVE = YES

# ------------------------------------------------------------

# Exclusions

# ------------------------------------------------------------

# Prevent Doxygen from reading its own generated documentation

EXCLUDE = docs/generated \
 docs/sprint2

# Ignore generated .NET folders and Git files

EXCLUDE_PATTERNS = _/bin/_ \
 _/obj/_ \
 _/.git/_ \
 _/node_modules/_

# ------------------------------------------------------------

# Documentation extraction

# ------------------------------------------------------------

EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO

HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO

# ------------------------------------------------------------

# Markdown documentation

# ------------------------------------------------------------

MARKDOWN_SUPPORT = YES
USE_MDFILE_AS_MAINPAGE = README.md

# ------------------------------------------------------------

# Source code display

# ------------------------------------------------------------

SOURCE_BROWSER = YES
INLINE_SOURCES = NO
STRIP_CODE_COMMENTS = NO

# ------------------------------------------------------------

# HTML output

# ------------------------------------------------------------

GENERATE_HTML = YES
HTML_OUTPUT = html

GENERATE_TREEVIEW = YES
SEARCHENGINE = YES

# ------------------------------------------------------------

# Disable unused output formats

# ------------------------------------------------------------

GENERATE_LATEX = NO
GENERATE_XML = NO

# ------------------------------------------------------------

# Graphviz

# ------------------------------------------------------------

HAVE_DOT = NO

# ------------------------------------------------------------

# Warnings

# ------------------------------------------------------------

QUIET = NO

WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES

# ------------------------------------------------------------

# C# support / readability

# ------------------------------------------------------------

OPTIMIZE_OUTPUT_FOR_C = NO
OPTIMIZE_OUTPUT_JAVA = YES

CASE_SENSE_NAMES = NO

SORT_MEMBER_DOCS = YES
SORT_BRIEF_DOCS = YES

# ------------------------------------------------------------

# File / class documentation

# ------------------------------------------------------------

SHOW_FILES = YES
SHOW_NAMESPACES = YES
SHOW_INCLUDE_FILES = NO

# ------------------------------------------------------------

# Navigation

# ------------------------------------------------------------

DISABLE_INDEX = NO
FULL_SIDEBAR = YES
